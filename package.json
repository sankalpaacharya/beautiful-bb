{
  "name": "bb-plugin-beautiful-bb",
  "version": "0.1.0",
  "type": "module",
  "description": "Make bb beautiful: themes and UI polish.",
  "repository": "https://github.com/sankalpaacharya/beautiful-bb",
  "license": "MIT",
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.49"
  },
  "scripts": {
    "build:themes": "node scripts/build-themes.mjs",
    "build": "node scripts/build-themes.mjs && bb plugin build ."
  },
  "bb": {
    "name": "Beautiful bb",
    "description": "Make bb beautiful: the T3 Night theme, a compact usage card, a wave spinner, and anime home wallpapers drawn in ASCII. Switch each feature on or off in settings.",
    "branding": {
      "icon": "./assets/icon.svg",
      "experimental_icons": {
        "sparkle": "./assets/icon.svg"
      }
    },
    "server": "./server.ts",
    "themes": [
      {
        "id": "t3-night",
        "name": "T3 Night",
        "description": "T3 Code's zinc palette with a lavender accent and a starry sidebar",
        "css": "./themes/t3-night.css",
        "codeTheme": {
          "dark": "./themes/t3-night-code-dark.json",
          "light": "./themes/t3-night-code-light.json"
        }
      },
      {
        "id": "sakura",
        "name": "Sakura",
        "description": "Soft pink accents and a blossom-dusk sidebar",
        "css": "./themes/sakura.css",
        "codeTheme": {
          "dark": "./themes/sakura-code-dark.json",
          "light": "./themes/sakura-code-light.json"
        }
      },
      {
        "id": "terminal",
        "name": "Terminal",
        "description": "Phosphor green on black, monospace everywhere",
        "css": "./themes/terminal.css",
        "codeTheme": {
          "dark": "./themes/terminal-code-dark.json",
          "light": "./themes/terminal-code-light.json"
        }
      },
      {
        "id": "ember",
        "name": "Ember",
        "description": "Warm reds and oranges with a glowing ember sidebar",
        "css": "./themes/ember.css",
        "codeTheme": {
          "dark": "./themes/ember-code-dark.json",
          "light": "./themes/ember-code-light.json"
        }
      }
    ],
    "app": "./app.tsx"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.49",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "hono": "^4.13.13",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
