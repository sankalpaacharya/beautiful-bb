{
  "name": "bb-plugin-beautiful-bb",
  "version": "0.1.0",
  "type": "module",
  "description": "Make bb beautiful: themes and UI polish.",
  "repository": "https://github.com/sankalpaacharya/beautiful-bb",
  "license": "MIT",
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.49"
  },
  "scripts": {
    "build:themes": "node scripts/build-themes.mjs",
    "build": "node scripts/build-themes.mjs && bb plugin build ."
  },
  "bb": {
    "name": "Beautiful bb",
    "description": "Themes and UI polish for bb: the T3 Night theme and a weekly usage card with burn-up charts for each agent harness.",
    "branding": {
      "icon": "Zap"
    },
    "server": "./server.ts",
    "themes": [
      {
        "id": "t3-night",
        "name": "T3 Night",
        "description": "T3 Code's zinc and indigo palette with a starry sidebar banner",
        "css": "./themes/t3-night.css"
      }
    ],
    "app": "./app.tsx"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.49",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "hono": "^4.13.13",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
