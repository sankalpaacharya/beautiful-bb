{
  "name": "bb-plugin-beautiful-bb",
  "version": "0.1.0",
  "type": "module",
  "description": "Make bb beautiful: themes and UI polish.",
  "repository": "https://github.com/sankalpaacharya/beautiful-bb",
  "license": "MIT",
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.49"
  },
  "scripts": {
    "build:themes": "node scripts/build-themes.mjs",
    "build": "node scripts/build-themes.mjs && bb plugin build ."
  },
  "bb": {
    "name": "Beautiful bb",
    "description": "Make bb beautiful: the T3 Night theme, a compact usage card, a wave spinner, and anime home wallpapers drawn in ASCII. Switch each feature on or off in settings.",
    "branding": {
      "icon": "./assets/icon.svg",
      "experimental_icons": {
        "sparkle": "./assets/icon.svg"
      }
    },
    "server": "./server.ts",
    "themes": [
      {
        "id": "t3-night",
        "name": "T3 Night",
        "description": "T3 Code's zinc palette with a lavender accent and a starry sidebar",
        "css": "./themes/t3-night.css",
        "codeTheme": {
          "dark": "./themes/t3-night-code-dark.json",
          "light": "./themes/t3-night-code-light.json"
        }
      },
      {
        "id": "tokyo-night",
        "name": "Tokyo Night",
        "description": "Deep navy with neon blues and purples, by enkia",
        "css": "./themes/tokyo-night.css",
        "codeTheme": {
          "dark": "tokyo-night",
          "light": "github-light-default"
        }
      },
      {
        "id": "rose-pine",
        "name": "Rosé Pine",
        "description": "Soho vibes: muted plum with rose, iris, and gold",
        "css": "./themes/rose-pine.css",
        "codeTheme": {
          "dark": "rose-pine",
          "light": "rose-pine-dawn"
        }
      },
      {
        "id": "kanagawa",
        "name": "Kanagawa",
        "description": "Inspired by Hokusai's Great Wave: ink, wave blue, and old paper",
        "css": "./themes/kanagawa.css",
        "codeTheme": {
          "dark": "kanagawa-wave",
          "light": "kanagawa-lotus"
        }
      },
      {
        "id": "everforest",
        "name": "Everforest",
        "description": "Soft forest greens that are easy on the eyes",
        "css": "./themes/everforest.css",
        "codeTheme": {
          "dark": "everforest-dark",
          "light": "everforest-light"
        }
      },
      {
        "id": "vesper",
        "name": "Vesper",
        "description": "Minimal near-black with a warm peach accent, by Rauno Freiberg",
        "css": "./themes/vesper.css",
        "codeTheme": {
          "dark": "vesper",
          "light": "github-light-default"
        }
      },
      {
        "id": "poimandres",
        "name": "Poimandres",
        "description": "Cool blue-gray with mint and sky highlights",
        "css": "./themes/poimandres.css",
        "codeTheme": {
          "dark": "poimandres",
          "light": "github-light-default"
        }
      }
    ],
    "app": "./app.tsx"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.49",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "hono": "^4.13.13",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
