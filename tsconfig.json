{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "noEmit": true,
    "skipLibCheck": false,
    "jsx": "react-jsx"
  },
  "include": [
    "server.ts",
    "tokens.ts",
    "features.ts",
    "app.tsx",
    "wallpaper.tsx",
    "settings-page.tsx",
    "css.d.ts"
  ]
}
